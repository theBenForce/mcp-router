{
  "name": "mcp-router",
  "version": "1.0.1",
  "description": "Local MCP Router & Proxy Gateway in TypeScript with Bun and SQLite",
  "private": true,
  "workspaces": [
    ".",
    "src/web",
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:web": "cd src/web && bun run dev",
    "start": "bun src/index.ts",
    "test": "DATABASE_PATH=:memory: bun test",
    "build:web": "cd src/web && bun run build",
    "build": "bun build:web",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "dev:all": "bun --watch src/index.ts & cd src/web && bun run dev",
    "tauri": "tauri",
    "dev:desktop": "bun scripts/build-backend.ts && tauri dev",
    "build:desktop": "bun run build:web && bun scripts/build-backend.ts && tauri build",
    "sync-version": "bun scripts/sync-version.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/bun": "^1.3.0",
    "@types/dockerode": "^4.0.1",
    "@types/mustache": "^4.2.6",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.0.0",
    "typescript": "^5.7.2",
    "semantic-release": "^24.2.1",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/exec": "^7.0.0"
  }
}
