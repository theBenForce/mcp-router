{
  "name": "mcp-router",
  "version": "1.0.0",
  "description": "Local MCP Router & Proxy Gateway in TypeScript with Bun and SQLite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:web": "bun src/web/node_modules/vite/bin/vite.js src/web --config src/web/vite.config.ts",
    "start": "bun src/index.ts",
    "test": "DATABASE_PATH=:memory: bun test",
    "build:web": "bun --cwd src/web run build",
    "build": "bun build:web",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "dev:all": "bun --watch src/index.ts & bun --cwd src/web run dev",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "bun run build:web && bun build --compile src/index.ts --outfile src-tauri/bin/backend && tauri build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/bun": "latest",
    "@types/dockerode": "^4.0.1",
    "@types/mustache": "^4.2.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  }
}
