{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "src-tauri/target/**/bundle/dmg/*.dmg",
            "label": "MCP-Router-macOS-AppleSilicon.dmg"
          }
        ]
      }
    ]
  ]
}
