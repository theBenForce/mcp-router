{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Router",
  "version": "1.0.0",
  "identifier": "com.mcprouter.app",
  "build": {
    "beforeDevCommand": "bun --cwd src/web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun --cwd src/web run build",
    "frontendDist": "../src/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCP Router — Gateway",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
