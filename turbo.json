{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build:web": {
      "outputs": ["src/web/dist/**"]
    },
    "build:backend": {
      "outputs": ["src-tauri/bin/**"]
    },
    "build:desktop": {
      "dependsOn": ["build:web", "build:backend"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    },
    "build": {
      "dependsOn": ["build:desktop"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build:web", "build:backend"]
    },
    "clean": {
      "cache": false
    }
  }
}
